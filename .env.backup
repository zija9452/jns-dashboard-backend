# Database
DATABASE_URL=postgresql+asyncpg://${DB_USER:-neondb_owner}:${DB_PASSWORD:-npg_xyWu6fOLo2KM}@${DB_HOST:-ep-old-cherry-a1c9xm25-pooler.ap-southeast-1.aws.neon.tech}:5432/neondb
NEON_DATABASE_URL=postgresql+asyncpg://${DB_USER:-neondb_owner}:${DB_PASSWORD:-npg_xyWu6fOLo2KM}@${DB_HOST:-ep-old-cherry-a1c9xm25-pooler.ap-southeast-1.aws.neon.tech}:5432/neondb
ALGORITHM='HS256'

# JWT Secrets - These should be replaced with strong, randomly generated secrets in production
ACCESS_TOKEN_SECRET_KEY=${ACCESS_TOKEN_SECRET_KEY:-6741b65cc7bd17c5d2e54e51e8a40b1f7de162a059e48db0901f726a0a6aa5a2}
REFRESH_TOKEN_SECRET_KEY=${REFRESH_TOKEN_SECRET_KEY:-jdRScgcFvC8YTUl7RG2mKBYOwcMIAxgbmLLJt9CBKa/SPK+x6KaheVgv2QdDTN+A}

# Security secrets - These should be replaced with strong, randomly generated secrets in production
SESSION_COOKIE_SECRET=${SESSION_COOKIE_SECRET:-replace_this_with_your_secure_session_secret}
CSRF_SECRET=${CSRF_SECRET:-replace_this_with_your_secure_csrf_secret}

# Email and SMS providers
EMAIL_PROVIDER_API_KEY=${EMAIL_PROVIDER_API_KEY:-SG.xxxxx}
SMS_PROVIDER_API_KEY=${SMS_PROVIDER_API_KEY:-TW.xxxxx}

# Application
APP_ENV=${APP_ENV:-development}
DEBUG=${DEBUG:-true}

# Disable OpenTelemetry in development (causes slow requests)
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Default Admin Credentials - These should be changed in production!
ADMIN_USERNAME=${ADMIN_USERNAME:-admin}
ADMIN_PASSWORD=${ADMIN_PASSWORD:-admin123}

# Token Expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=${ACCESS_TOKEN_EXPIRE_MINUTES:-15}
REFRESH_TOKEN_EXPIRE_DAYS=${REFRESH_TOKEN_EXPIRE_DAYS:-30}

# Session Timeout (in hours)
SESSION_TIMEOUT_HOURS=${SESSION_TIMEOUT_HOURS:-3}

# Redis
REDIS_URL=${REDIS_URL:-redis://redis:6379}

# Pagination
DEFAULT_PAGE_SIZE=${DEFAULT_PAGE_SIZE:-50}
MAX_PAGE_SIZE=${MAX_PAGE_SIZE:-200}

# Database credentials for docker-compose
DB_USER=${DB_USER:-neondb_owner}
DB_PASSWORD=${DB_PASSWORD:-npg_DSJeaHiRo69W}
POSTGRES_DB=${POSTGRES_DB:-neobdb}